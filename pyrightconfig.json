// Configures Pylance (VS Code's bundled Pyright) for the Python scripts under Assets/Scripts.
// They import matcha_engine, a PYBIND11_EMBEDDED_MODULE (see
// MatchaEngine/Code/Scripting/MatchaPythonBindings.cpp) that only exists inside the engine's
// embedded interpreter at runtime - there's no installed package on disk for Pylance to find, so
// without this it reports every "import matcha_engine" as unresolved and treats every value that
// comes from it as Unknown.
{
    "stubPath": "MatchaEngine/PythonStubs",
    "include": [
        "Sandbox/Assets/Scripts",
        "MatchaEditor/Assets/Scripts"
    ],

    // matcha_engine has a stub (matcha_engine.pyi in stubPath above) but no real .py/.pyd file
    // Pylance can locate next to it - expected for an embedded-only module, not something worth
    // flagging as a problem.
    "reportMissingModuleSource": "none",

    "pythonVersion": "3.12",
    "typeCheckingMode": "basic"
}
