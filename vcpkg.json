{
    "name": "matcha",
    "version": "0.1.0",
    "dependencies": [
        {
            "name": "sdl3",
            "default-features": false,
            "features": [
                "wayland",
                "x11"
            ],
            "platform": "linux"
        },
        {
            "name": "sdl3",
            "platform": "!linux"
        },
        "nlohmann-json",
        "spdlog",
        "glm",
        "imgui",
        "stb",
        "assimp",
        "efsw",
        "entt",
        {
            "name": "qtbase",
            "default-features": false,
            "features": [
                "widgets",
                "opengl",
                "png"
            ]
        },
        {
            "name": "pybind11",
            "default-features": false
        }
    ]
}